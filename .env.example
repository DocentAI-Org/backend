APP_NAME=DocentAI API
APP_VERSION=0.1.0
ALLOWED_ORIGINS=http://localhost:3000

# Supabase (values from `npx supabase status -o env`)
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Set for HS256 projects (local CLI); leave empty to verify tokens with the project JWKS.
SUPABASE_JWT_SECRET=
STORAGE_BUCKET=course-material
SIGNED_URL_TTL_SECONDS=300
PSEUDONYM_EMAIL_DOMAIN=students.docentai.invalid

# LLM (specs/014): provider ollama | openai | anthropic, and model, for every task...
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
# ...unless a task has its own: TUTOR (chat), FEEDBACK (exercises), REVIEW (repeated
# mistakes), QUESTIONS (quiz drafts). EFFORT (low…max) is for Anthropic models.
# LLM_FEEDBACK_PROVIDER=anthropic
# LLM_FEEDBACK_MODEL=claude-sonnet-5-5
# LLM_FEEDBACK_EFFORT=low
# Provider endpoints and keys (keys only here, never in the database).
OLLAMA_BASE_URL=http://localhost:11434/v1
# OPENAI_BASE_URL=https://api.openai.com/v1   # or any OpenAI-compatible API
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Server-side fallback when a Claude model declines ("" turns it off).
LLM_ANTHROPIC_FALLBACKS=default
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SECONDS=60
# Embeddings: ollama | openai (Anthropic has none). Changing them needs re-processing.
LLM_EMBEDDING_PROVIDER=ollama
LLM_EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
# USD per million tokens [input, output] by model, for the interaction log; current
# Claude models are built in. Other models use the two fallbacks (0 for local ones).
# LLM_PRICES={"gpt-example": [0.15, 0.60]}
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0
# Exercise feedback; the chat keeps 0.2 (specs/009).
LLM_FEEDBACK_TEMPERATURE=0

# Retrieval and context
RETRIEVAL_TOP_K=4
# Tuned for bge-m3 on sample material; re-tune with the evaluation set (§4.4).
RETRIEVAL_MIN_SIMILARITY=0.55
# Exercises match the material less closely; measured in specs/009 (evaluation.md).
RETRIEVAL_MIN_SIMILARITY_EXERCISES=0.40
HISTORY_MAX_MESSAGES=6

# Limits
DAILY_MESSAGE_LIMIT=30
DAILY_RESET_TIMEZONE=Europe/Madrid
MAX_UPLOAD_MB=20
TUTOR_LANGUAGE=es

# Repeated mistake (provisional, specs/005): same error type and topic N times in D days
REPEATED_MISTAKE_COUNT=3
REPEATED_MISTAKE_DAYS=30
# Adaptive quizzes (specs/006, provisional)
QUIZ_LENGTH=5
QUIZ_START_LEVEL=2
QUIZ_STREAK=2
# Progress by topic (specs/007, provisional)
PROGRESS_WINDOW=10
PROGRESS_MIN_ITEMS=3
PROGRESS_PROGRESSING=0.5
PROGRESS_MASTERED=0.8

# Version of the study consent text students accept; change it when the text changes.
CONSENT_VERSION=2026-10

# Key for the pseudonymous student reference in interaction logs. Change it.
LOG_PSEUDONYM_SECRET=change-me
# Student ids in the study export (specs/011); different from the one above.
STUDY_EXPORT_SECRET=change-me-too
