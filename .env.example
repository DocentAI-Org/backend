APP_NAME=DocentAI API
APP_VERSION=0.1.0
ALLOWED_ORIGINS=http://localhost:3000

# Supabase (values from `npx supabase status -o env`)
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Set for HS256 projects (local CLI); leave empty to verify tokens with the project JWKS.
SUPABASE_JWT_SECRET=
STORAGE_BUCKET=course-material
SIGNED_URL_TTL_SECONDS=300
PSEUDONYM_EMAIL_DOMAIN=students.docentai.invalid

# LLM: any OpenAI-compatible provider. Default: local Ollama (zero cost).
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_CHAT_MODEL=qwen2.5:7b
LLM_EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
LLM_TIMEOUT_SECONDS=60
# USD per million tokens, for the interaction log (0 for local models).
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0

# Retrieval and context
RETRIEVAL_TOP_K=4
# Tuned for bge-m3 on sample material; re-tune with the evaluation set (§4.4).
RETRIEVAL_MIN_SIMILARITY=0.55
HISTORY_MAX_MESSAGES=6

# Limits
DAILY_MESSAGE_LIMIT=30
DAILY_RESET_TIMEZONE=Europe/Madrid
MAX_UPLOAD_MB=20
TUTOR_LANGUAGE=es

# Repeated mistake (provisional, specs/005): same error type and topic N times in D days
REPEATED_MISTAKE_COUNT=3
REPEATED_MISTAKE_DAYS=30
# Adaptive quizzes (specs/006, provisional)
QUIZ_LENGTH=5
QUIZ_START_LEVEL=2
QUIZ_STREAK=2

# Version of the study consent text students accept; change it when the text changes.
CONSENT_VERSION=2026-10

# Key for the pseudonymous student reference in interaction logs. Change it.
LOG_PSEUDONYM_SECRET=change-me
